# Copy these values into your hosting provider's environment configuration.
# Do not commit a real .env file or place real secrets in public web files.
BLAZE_DB_HOST=localhost
BLAZE_DB_USER=your_database_user
BLAZE_DB_PASSWORD=your_database_password
BLAZE_DB_NAME=blaze_bakery
BLAZE_DB_PORT=3306
BLAZE_DELIVERY_COMMUNITY=your actual delivery community
BLAZE_PUBLIC_URL=https://your-domain.example
BLAZE_ADMIN_SETUP_TOKEN=

# Add these only when a real payment provider is configured server-side.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
